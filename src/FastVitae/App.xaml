<Application x:Class="FastVitae.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="clr-namespace:FastVitae.Model"
             xmlns:root="clr-namespace:FastVitae"
             xmlns:views="clr-namespace:FastVitae.Views"
             ThemeMode="Dark">
    <Application.Resources>
        <ResourceDictionary>
        <!-- Dark theme loads first -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Dark.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <views:TranslateConverter x:Key="Translate"/>
        <!-- Stored English word, shown translated -->
        <DataTemplate x:Key="TranslatedItem">
            <TextBlock Text="{Binding Converter={StaticResource Translate}}"/>
        </DataTemplate>

        <!-- Dark gray colors -->
        <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#3A3D42"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#3A3D42"/>
        <SolidColorBrush x:Key="CardBrush" Color="#45484E"/>
        <SolidColorBrush x:Key="InsetBrush" Color="#3E4146"/>
        <SolidColorBrush x:Key="LineBrush" Color="#5A5D63"/>
        <SolidColorBrush x:Key="PreviewBackBrush" Color="#33363A"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A9ACB2"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#FF8A80"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#81C784"/>

        <!-- Shared styles -->
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <!-- Country code dropdown -->
        <DataTemplate x:Key="CountryTemplate">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Flag}" Width="16" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="NameText" Text="{Binding Name}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding DialCode}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <!-- Closed box hides the name -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                    <Setter TargetName="NameText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="CountryCombo" TargetType="ComboBox">
            <Setter Property="views:Search.Kind" Value="Country"/>
            <Setter Property="ItemTemplate" Value="{StaticResource CountryTemplate}"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <!-- Fits the longest code -->
            <Setter Property="Width" Value="96"/>
        </Style>
        <!-- Currency dropdown -->
        <DataTemplate x:Key="CurrencyTemplate">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Flag}" Width="16" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Symbol}" MinWidth="28" Margin="0,0,6,0"/>
                <TextBlock x:Name="NameText" Text="{Binding Name}" Margin="0,0,8,0"/>
                <TextBlock x:Name="CodeText" Text="{Binding Code}" Visibility="Collapsed"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <!-- Closed box: flag, symbol, code -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                    <Setter TargetName="NameText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="CodeText" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="CurrencyCombo" TargetType="ComboBox">
            <Setter Property="views:Search.Kind" Value="Currency"/>
            <Setter Property="ItemTemplate" Value="{StaticResource CurrencyTemplate}"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="Width" Value="120"/>
        </Style>
        <!-- Main button -->
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1F5FBF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#1F5FBF"/>
            <!-- Own look: teal hover -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#1E8C8C"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#1E8C8C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#177070"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#177070"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Green update button -->
        <Style x:Key="UpdateButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#2E7D32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#388E3C"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#1B5E20"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#1B5E20"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Small form button -->
        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="MinWidth" Value="24"/>
        </Style>
        <!-- Language dropdown with flags -->
        <Style x:Key="LanguageCombo" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="ItemsSource" Value="{x:Static root:Text.Languages}"/>
            <Setter Property="SelectedValuePath" Value="Code"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Flag}" Width="16" Height="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Folder icon button -->
        <Style x:Key="FolderButton" TargetType="Button" BasedOn="{StaticResource Small}">
            <Setter Property="Content" Value="&#xE838;"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
