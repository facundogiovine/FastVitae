<Window x:Class="FastVitae.Views.PromptWindow"
        Background="{StaticResource PanelBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FastVitae.Views"
        Width="380" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="LabelText" Margin="0,0,0,4"/>
        <TextBox x:Name="AnswerBox"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{views:T 'Cancel'}" IsCancel="True"/>
            <Button Content="OK" IsDefault="True" Margin="0" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
