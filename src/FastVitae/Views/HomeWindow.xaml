<Window x:Class="FastVitae.Views.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:storage="clr-namespace:FastVitae.Storage"
        Title="Fast Vitae" Width="860" Height="560" MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Fields" Click="Fields_Click" ToolTip="Saved content per kind of job, to start new CVs from"/>
                <Button Content="Profile" Click="Profile_Click" ToolTip="Edit your basic info"/>
                <Button x:Name="ProfilesButton" Content="Profiles ▾" Margin="0" Click="Profiles_Click" ToolTip="Switch, add or delete profiles"/>
            </StackPanel>
            <Button Content="New CV" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="NewCv_Click"/>
        </DockPanel>

        <TabControl>
            <!-- CVs by company -->
            <TabItem Header="CVs">
                <DockPanel Margin="8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="Open" Click="Open_Click"/>
                        <Button Content="Open folder" Click="OpenFolder_Click"/>
                    </StackPanel>

                    <Grid>
                        <ListView x:Name="CvList" MouseDoubleClick="Open_Click">
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="4,10,0,2"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Role" Width="320" DisplayMemberBinding="{Binding Role}"/>
                                    <GridViewColumn Header="Last edit" Width="150" DisplayMemberBinding="{Binding LastEdit, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                                    <GridViewColumn Header="" Width="220">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="Warning" Text="This file could not be read" Foreground="#B00020" Visibility="Collapsed"/>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Unreadable}" Value="True">
                                                        <Setter TargetName="Warning" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock x:Name="EmptyText" Text="No CVs yet"
                                   Foreground="#777777" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Job applications -->
            <TabItem Header="Applications">
                <DockPanel Margin="8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,10">
                        <ComboBox x:Name="FieldFilter" Width="170" SelectionChanged="Filter_Changed" ToolTip="Show one Field"/>
                        <ComboBox x:Name="StatusFilter" Width="140" Margin="8,0,0,0" SelectionChanged="Filter_Changed" ToolTip="Show one status"/>
                    </StackPanel>

                    <Grid>
                        <ListView x:Name="ApplicationList">
                            <ListView.ItemContainerStyle>
                                <!-- Row colour shows status -->
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="{Binding StatusColor}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="MinHeight" Value="34"/>
                                    <Setter Property="BorderBrush" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Field" Width="130" DisplayMemberBinding="{Binding Field}"/>
                                    <GridViewColumn Header="Company" Width="175" DisplayMemberBinding="{Binding Company}"/>
                                    <GridViewColumn Header="Role" Width="175" DisplayMemberBinding="{Binding Role}"/>
                                    <GridViewColumn Header="Date applied" Width="100" DisplayMemberBinding="{Binding DateApplied, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                                    <GridViewColumn Header="Status" Width="125">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{x:Static storage:ApplicationStatus.All}"
                                                          SelectedItem="{Binding Status, Mode=OneWay}"
                                                          SelectionChanged="Status_Changed" ToolTip="Change the status"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="CV" Width="56">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Click="OpenCv_Click" Padding="4,2" Margin="0" Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" ToolTip="Open the CV you applied with">
                                                    <!-- Page icon with CV -->
                                                    <Grid Width="18" Height="22">
                                                        <Path Data="M1,1 L12,1 L17,6 L17,21 L1,21 Z" Fill="White" Stroke="#444444" StrokeThickness="1.2" StrokeLineJoin="Round"/>
                                                        <Path Data="M12,1 L12,6 L17,6 Z" Fill="#D5D8DC" Stroke="#444444" StrokeThickness="1.2" StrokeLineJoin="Round"/>
                                                        <TextBlock Text="CV" FontSize="8" FontWeight="Bold" Foreground="#1F5FBF"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock x:Name="NoApplicationsText" Text="No applications yet"
                                   Foreground="#777777" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
