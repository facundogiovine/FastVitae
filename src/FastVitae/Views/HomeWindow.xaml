<Window x:Class="FastVitae.Views.HomeWindow"
        Background="{StaticResource PanelBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FastVitae.Views"
        xmlns:storage="clr-namespace:FastVitae.Storage"
        Title="Fast Vitae" Width="1120" Height="620" MinWidth="900" MinHeight="360"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="UpdateButton" Content="{views:T 'Update'}" Style="{StaticResource UpdateButton}" Margin="0,0,12,0"
                        Visibility="Collapsed" Click="Update_Click"/>
                <!-- Bubble under Update button -->
                <Popup x:Name="UpdateBubble" PlacementTarget="{Binding ElementName=UpdateButton}" Placement="Bottom"
                       AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
                    <StackPanel Margin="0,4,0,0" MouseLeftButtonDown="UpdateBubble_Click" Cursor="Hand">
                        <Path Data="M0,8 L8,0 L16,8 Z" Fill="{StaticResource CardBrush}" Stroke="#2E7D32" StrokeThickness="1"
                              HorizontalAlignment="Left" Margin="14,0,0,-1"/>
                        <Border Background="{StaticResource CardBrush}" BorderBrush="#2E7D32" BorderThickness="1" CornerRadius="6" Padding="12,8">
                            <TextBlock Text="{views:T 'There\'s an Update available'}" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Popup>
                <ComboBox x:Name="LanguageBox" Style="{StaticResource LanguageCombo}" Margin="0,0,12,0" VerticalAlignment="Center"
                          SelectionChanged="Language_Changed" ToolTip="{views:T 'Language'}"/>
                <Button Content="{views:T 'Fields'}" Click="Fields_Click" ToolTip="{views:T 'Saved content per kind of job, to start new CVs from'}"/>
                <Button Content="{views:T 'Profile'}" Click="Profile_Click" ToolTip="{views:T 'Edit your basic info'}"/>
                <Button x:Name="ProfilesButton" Content="{views:T 'Profiles ▾'}" Margin="0" Click="Profiles_Click" ToolTip="{views:T 'Switch, add or delete profiles'}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="{views:T 'New CV'}" Style="{StaticResource Primary}" Click="NewCv_Click"/>
                <Button Style="{StaticResource FolderButton}" Margin="8,0,0,0" Click="OpenCvsFolder_Click" ToolTip="{views:T 'Open the CVs folder'}"/>
                <Button Content="{views:T 'Save Folder'}" Margin="8,0,0,0" Click="SaveLocation_Click" ToolTip="{views:T 'Change where CVs are saved'}"/>
            </StackPanel>
        </DockPanel>

        <TabControl>
            <!-- CVs by company -->
            <TabItem Header="{views:T 'CVs'}">
                <DockPanel Margin="8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="{views:T 'Open'}" Click="Open_Click"/>
                    </StackPanel>

                    <Grid>
                        <ListView x:Name="CvList" MouseDoubleClick="Open_Click">
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="4,10,0,2"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{views:T 'Role'}" Width="320" DisplayMemberBinding="{Binding Role}"/>
                                    <GridViewColumn Header="{views:T 'Last edit'}" Width="150" DisplayMemberBinding="{Binding LastEdit, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                                    <GridViewColumn Header="" Width="56">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource FolderButton}" Margin="0" Click="OpenFolder_Click" ToolTip="{views:T 'Open in folder'}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="" Width="56">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource FolderButton}" Content="&#xE70F;" Margin="0" Click="EditCv_Click" ToolTip="{views:T 'Edit'}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="" Width="220">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="Warning" Text="{views:T 'This file could not be read'}" Foreground="{StaticResource ErrorBrush}" Visibility="Collapsed"/>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Unreadable}" Value="True">
                                                        <Setter TargetName="Warning" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock x:Name="EmptyText" Text="{views:T 'No CVs yet'}"
                                   Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Job applications -->
            <TabItem Header="{views:T 'Applications'}">
                <DockPanel Margin="8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,10">
                        <ComboBox x:Name="FieldFilter" Width="170" SelectionChanged="Filter_Changed" ToolTip="{views:T 'Show one Field'}"/>
                        <ComboBox x:Name="StatusFilter" ItemTemplate="{StaticResource TranslatedItem}" Width="170" Margin="8,0,0,0" SelectionChanged="Filter_Changed" ToolTip="{views:T 'Show one status'}"/>
                    </StackPanel>

                    <Grid>
                        <ListView x:Name="ApplicationList">
                            <ListView.ItemContainerStyle>
                                <!-- Row colour shows status -->
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
                                    <Setter Property="Background" Value="{Binding StatusColor}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="MinHeight" Value="34"/>
                                    <!-- Status colour, darker on hover -->
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="4" Margin="0,0,0,2" Padding="6,0,0,0">
                                                    <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}"
                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{Binding StatusHoverColor}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{Binding StatusHoverColor}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{views:T 'Field'}" Width="190" DisplayMemberBinding="{Binding Field}"/>
                                    <GridViewColumn Header="{views:T 'Company'}" Width="175" DisplayMemberBinding="{Binding Company}"/>
                                    <GridViewColumn Header="{views:T 'Role'}" Width="175" DisplayMemberBinding="{Binding Role}"/>
                                    <GridViewColumn Header="{views:T 'Date applied'}" Width="165" DisplayMemberBinding="{Binding DateApplied, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                                    <GridViewColumn Header="{views:T 'Status'}" Width="135">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{x:Static storage:ApplicationStatus.All}" ItemTemplate="{StaticResource TranslatedItem}"
                                                          SelectedItem="{Binding Status, Mode=OneWay}"
                                                          SelectionChanged="Status_Changed" ToolTip="{views:T 'Change the status'}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="CV" Width="56">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Click="OpenCv_Click" Padding="4,2" Margin="0" Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" ToolTip="{views:T 'Open the CV you applied with'}">
                                                    <!-- Page icon with CV -->
                                                    <Grid Width="18" Height="22">
                                                        <Path Data="M1,1 L12,1 L17,6 L17,21 L1,21 Z" Fill="White" Stroke="#444444" StrokeThickness="1.2" StrokeLineJoin="Round"/>
                                                        <Path Data="M12,1 L12,6 L17,6 Z" Fill="#D5D8DC" Stroke="#444444" StrokeThickness="1.2" StrokeLineJoin="Round"/>
                                                        <TextBlock Text="CV" FontSize="8" FontWeight="Bold" Foreground="#1F5FBF"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{views:T 'Folder'}" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource FolderButton}" Margin="0" VerticalAlignment="Center" Click="ShowCvFile_Click"
                                                        ToolTip="{views:T 'Open in folder'}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock x:Name="NoApplicationsText" Text="{views:T 'No applications yet'}"
                                   Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
