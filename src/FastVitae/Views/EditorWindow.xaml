<Window x:Class="FastVitae.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FastVitae.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FastVitae" Width="1320" Height="820" MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Window.Resources>
        <views:BulletLinesConverter x:Key="BulletLines"/>

        <!-- One role -->
        <DataTemplate x:Key="RoleTemplate">
            <StackPanel Margin="0,8,0,0">
                <DockPanel>
                    <Button Content="✕" Style="{StaticResource Small}" DockPanel.Dock="Right" Click="RemoveRole_Click" ToolTip="Remove this role"/>
                    <TextBox Text="{Binding Dates, UpdateSourceTrigger=PropertyChanged}" DockPanel.Dock="Right" Width="170" Margin="6,0,0,0" ToolTip="Dates, for example: October 2022 - Present"/>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" ToolTip="Job title, degree or role"/>
                </DockPanel>
                <TextBox Text="{Binding Bullets, Converter={StaticResource BulletLines}, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Margin="0,4,0,0"
                         ToolTip="One bullet per line"/>
            </StackPanel>
        </DataTemplate>

        <!-- One entry with roles -->
        <DataTemplate x:Key="EntryTemplate">
            <Border BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button Content="✕" Style="{StaticResource Small}" DockPanel.Dock="Right" Click="RemoveEntry_Click" ToolTip="Remove this entry"/>
                        <TextBox Text="{Binding Place, UpdateSourceTrigger=PropertyChanged}" DockPanel.Dock="Right" Width="170" Margin="6,0,0,0" ToolTip="Place, for example: Asuncion, Paraguay"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" ToolTip="Company, school or project name"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Roles}" ItemTemplate="{StaticResource RoleTemplate}"/>
                    <Button Content="+ Role" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,2" Click="AddRole_Click"
                            ToolTip="Add another role in the same place"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One section -->
        <DataTemplate x:Key="SectionTemplate">
            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <Button Content="✕" Style="{StaticResource Small}" DockPanel.Dock="Right" Click="RemoveSection_Click" ToolTip="Remove this section"/>
                        <Button Content="▼" Style="{StaticResource Small}" DockPanel.Dock="Right" Click="MoveSectionDown_Click" ToolTip="Move down"/>
                        <Button Content="▲" Style="{StaticResource Small}" DockPanel.Dock="Right" Click="MoveSectionUp_Click" ToolTip="Move up"/>
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" ToolTip="Section title"/>
                    </DockPanel>

                    <TextBox x:Name="ColumnsEditor" Visibility="Collapsed"
                             Text="{Binding Bullets, Converter={StaticResource BulletLines}, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" Margin="0,8,0,0"
                             ToolTip="One bullet per line. They are printed in three columns."/>

                    <StackPanel x:Name="EntriesEditor">
                        <ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource EntryTemplate}"/>
                        <Button Content="+ Entry" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="8,2" Click="AddEntry_Click"
                                ToolTip="Add a company, school or project"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Layout}" Value="BulletColumns">
                    <Setter TargetName="ColumnsEditor" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="EntriesEditor" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500" MinWidth="380"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- Left: the form. -->
        <DockPanel Grid.Column="0" Background="#F4F5F7">
            <Border DockPanel.Dock="Bottom" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="12,10">
                <DockPanel>
                    <Button x:Name="CreateButton" Content="Create" Style="{StaticResource Primary}" DockPanel.Dock="Right" Margin="0" Click="Create_Click"
                            ToolTip="Write the CV as PDF and Word into the company folder"/>
                    <Button x:Name="SaveToSpecialtyButton" Content="Save to Specialty" DockPanel.Dock="Left" Click="SaveToSpecialty_Click"
                            ToolTip="Keep this content so new CVs can start from it"/>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis" Foreground="#2E7D32"/>
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FormPanel" Margin="12">
                    <Expander x:Name="BasicInfoExpander" Header="Basic info" Margin="0,0,0,8">
                        <StackPanel DataContext="{Binding BasicInfo}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="First name" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Last name" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Title" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Location" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Country code" Style="{StaticResource Label}"/>
                                    <ComboBox Style="{StaticResource CountryCombo}" SelectedValue="{Binding Country}" SelectionChanged="Country_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Phone number" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Email address" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="LinkedIn link" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding LinkedIn, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Expander>

                    <CheckBox x:Name="PictureOption" Content="Picture" IsChecked="{Binding ShowPicture}" Margin="0,0,0,10"
                              Click="PictureOption_Click" ToolTipService.ShowOnDisabled="True"
                              ToolTip="Name and title on the left, your picture on the right"/>

                    <Expander Header="Summary" IsExpanded="True" Margin="0,0,0,12">
                        <TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="False" TextWrapping="Wrap" MinHeight="64" Margin="0,6,0,0"
                                 ToolTip="Two to four lines about who you are. Leave empty to skip it."/>
                    </Expander>

                    <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionTemplate}"/>

                    <Button Content="+ Add Section" HorizontalAlignment="Left" Click="AddSection_Click"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#CCCCCC"/>

        <!-- Right: the live preview. -->
        <Grid Grid.Column="2" Background="#E9EAEE">
            <wv2:WebView2 x:Name="Preview" SizeChanged="Preview_SizeChanged"/>
            <TextBlock x:Name="PreviewError" Visibility="Collapsed" TextWrapping="Wrap" Margin="24"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B00020"/>
        </Grid>
    </Grid>
</Window>
