<Window x:Class="FastVitae.Views.FieldsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fields" Width="620" Height="420" MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock Text="Fields" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="Add" Click="AddField_Click" ToolTip="Add a kind of job, for example: Programming"/>
                <Button Content="Rename" Click="RenameField_Click"/>
                <Button Content="Delete" Click="DeleteField_Click"/>
            </StackPanel>
            <ListBox x:Name="FieldList" SelectionChanged="FieldList_SelectionChanged"/>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <TextBlock Text="Specialties" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="Add" Click="AddSpecialty_Click" ToolTip="Add a specialty inside the selected Field, for example: C#"/>
                <Button Content="Edit" Click="EditSpecialty_Click" ToolTip="Edit the content saved in this Specialty"/>
                <Button Content="Rename" Click="RenameSpecialty_Click"/>
                <Button Content="Delete" Click="DeleteSpecialty_Click"/>
            </StackPanel>
            <ListBox x:Name="SpecialtyList" MouseDoubleClick="EditSpecialty_Click"/>
        </DockPanel>
    </Grid>
</Window>
