<Window x:Class="FastVitae.Views.FieldsWindow"
        Background="{StaticResource PanelBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FastVitae.Views"
        Title="{views:T 'Fields'}" Width="620" Height="420" MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock Text="{views:T 'Fields'}" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="{views:T 'Add'}" Click="AddField_Click" ToolTip="{views:T 'Add a kind of job, for example: Programming'}"/>
                <Button Content="{views:T 'Rename'}" Click="RenameField_Click"/>
                <Button Content="{views:T 'Delete'}" Click="DeleteField_Click"/>
            </StackPanel>
            <ListBox x:Name="FieldList" SelectionChanged="FieldList_SelectionChanged"/>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <TextBlock Text="{views:T 'Specialties'}" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="{views:T 'Add'}" Click="AddSpecialty_Click" ToolTip="{views:T 'Add a specialty inside the selected Field, for example: C#'}"/>
                <Button Content="{views:T 'Edit'}" Click="EditSpecialty_Click" ToolTip="{views:T 'Edit the content saved in this Specialty'}"/>
                <Button Content="{views:T 'Rename'}" Click="RenameSpecialty_Click"/>
                <Button Content="{views:T 'Delete'}" Click="DeleteSpecialty_Click"/>
            </StackPanel>
            <ListBox x:Name="SpecialtyList" MouseDoubleClick="EditSpecialty_Click"/>
        </DockPanel>
    </Grid>
</Window>
