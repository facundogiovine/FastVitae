<Window x:Class="FastVitae.Views.SaveToSpecialtyWindow"
        Background="{StaticResource PanelBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FastVitae.Views"
        Title="{views:T 'Save to Specialty'}" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="{views:T 'Field'}" Style="{StaticResource Label}" Margin="0,0,0,2"/>
        <ComboBox x:Name="FieldCombo" IsEditable="True" LostFocus="FieldCombo_LostFocus" SelectionChanged="FieldCombo_SelectionChanged"
                  ToolTip="{views:T 'Pick a Field or type a new one, for example: Programming'}"/>

        <TextBlock Text="{views:T 'Specialty'}" Style="{StaticResource Label}"/>
        <ComboBox x:Name="SpecialtyCombo" IsEditable="True"
                  ToolTip="{views:T 'Pick a Specialty or type a new one, for example: C#'}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{views:T 'Cancel'}" IsCancel="True"/>
            <Button Content="{views:T 'Save'}" IsDefault="True" Style="{StaticResource Primary}" Margin="0" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
