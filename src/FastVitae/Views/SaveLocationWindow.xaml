<Window x:Class="FastVitae.Views.SaveLocationWindow"
        Background="{StaticResource PanelBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FastVitae.Views"
        Title="{views:T 'Fast Vitae - Save Folder'}" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="{views:T 'Folder'}" Style="{StaticResource Label}"/>
        <DockPanel>
            <Button Content="{views:T 'Browse...'}" DockPanel.Dock="Right" Margin="6,0,0,0" Click="Browse_Click"/>
            <TextBox x:Name="FolderBox"/>
        </DockPanel>
        <CheckBox x:Name="OnlyNewCvs" Content="{views:T 'Only CVs created from now on'}" Margin="0,12,0,0" Click="OnlyNewCvs_Click"/>
        <TextBlock x:Name="MoveNote" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{views:T 'Cancel'}" IsCancel="True"/>
            <Button Content="{views:T 'Save'}" IsDefault="True" Style="{StaticResource Primary}" Margin="0" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
