<Window x:Class="FastVitae.Views.SetupWindow"
        Background="{StaticResource PanelBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FastVitae.Views"
        Title="{views:T 'Fast Vitae - Your details'}" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <DockPanel>
            <ComboBox x:Name="LanguageBox" Style="{StaticResource LanguageCombo}" DockPanel.Dock="Right" VerticalAlignment="Center"
                      SelectionChanged="Language_Changed" ToolTip="{views:T 'Language'}"/>
            <TextBlock Text="{views:T 'Your basic info'}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="ReasonText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{views:T 'First name'}" Style="{StaticResource Label}"/>
                <TextBox x:Name="FirstNameBox" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{views:T 'Last name'}" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="{views:T 'Title'}" Style="{StaticResource Label}"/>
        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" ToolTip="{views:T 'For example: Software Developer'}"/>

        <TextBlock Text="{views:T 'Location'}" Style="{StaticResource Label}"/>
        <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" ToolTip="{views:T 'Where you live, or where you are looking to relocate'}"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{views:T 'Country code'}" Style="{StaticResource Label}"/>
                <ComboBox Style="{StaticResource CountryCombo}" views:Search.Value="{Binding Country}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{views:T 'Phone number'}" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="{views:T 'Email address'}" Style="{StaticResource Label}"/>
        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="{views:T 'LinkedIn link'}" Style="{StaticResource Label}"/>
        <TextBox Text="{Binding LinkedIn, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="{views:T 'Picture'}" Style="{StaticResource Label}"/>
        <StackPanel Orientation="Horizontal">
            <Border Width="56" Height="70" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource InsetBrush}" Margin="0,0,10,0"
                    ToolTip="{views:T 'Optional. Shown on CVs that have Picture turned on.'}">
                <Image x:Name="PictureImage" Stretch="UniformToFill"/>
            </Border>
            <Button Content="{views:T 'Choose...'}" VerticalAlignment="Center" Click="ChoosePicture_Click"/>
            <Button x:Name="RemovePictureButton" Content="{views:T 'Remove'}" VerticalAlignment="Center" Click="RemovePicture_Click" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel x:Name="FolderPanel">
            <TextBlock Text="{views:T 'Data folder'}" Style="{StaticResource Label}"/>
            <DockPanel>
                <Button Content="{views:T 'Browse...'}" DockPanel.Dock="Right" Margin="6,0,0,0" Click="Browse_Click"/>
                <TextBox x:Name="FolderBox" ToolTip="{views:T 'Where Fast Vitae keeps your profiles and CVs'}"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{views:T 'Cancel'}" IsCancel="True"/>
            <Button Content="{views:T 'Continue'}" IsDefault="True" Style="{StaticResource Primary}" Margin="0" Click="Continue_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
