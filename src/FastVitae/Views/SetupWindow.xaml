<Window x:Class="FastVitae.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fast Vitae - Your details" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Your basic info" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="ReasonText" Foreground="#B00020" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="First name" Style="{StaticResource Label}"/>
                <TextBox x:Name="FirstNameBox" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Last name" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Title" Style="{StaticResource Label}"/>
        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" ToolTip="For example: Software Developer"/>

        <TextBlock Text="Location" Style="{StaticResource Label}"/>
        <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" ToolTip="Where you live, or where you are looking to relocate"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Country code" Style="{StaticResource Label}"/>
                <ComboBox Style="{StaticResource CountryCombo}" SelectedValue="{Binding Country}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Phone number" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Email address" Style="{StaticResource Label}"/>
        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="LinkedIn link" Style="{StaticResource Label}"/>
        <TextBox Text="{Binding LinkedIn, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Picture" Style="{StaticResource Label}"/>
        <StackPanel Orientation="Horizontal">
            <Border Width="56" Height="70" BorderBrush="#BBBBBB" BorderThickness="1" Background="#F4F5F7" Margin="0,0,10,0"
                    ToolTip="Optional. Shown on CVs that have Picture turned on.">
                <Image x:Name="PictureImage" Stretch="UniformToFill"/>
            </Border>
            <Button Content="Choose..." VerticalAlignment="Center" Click="ChoosePicture_Click"/>
            <Button x:Name="RemovePictureButton" Content="Remove" VerticalAlignment="Center" Click="RemovePicture_Click" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel x:Name="FolderPanel">
            <TextBlock Text="Data folder" Style="{StaticResource Label}"/>
            <DockPanel>
                <Button Content="Browse..." DockPanel.Dock="Right" Margin="6,0,0,0" Click="Browse_Click"/>
                <TextBox x:Name="FolderBox" ToolTip="Where Fast Vitae keeps your profiles and CVs"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True"/>
            <Button Content="Continue" IsDefault="True" Style="{StaticResource Primary}" Margin="0" Click="Continue_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
