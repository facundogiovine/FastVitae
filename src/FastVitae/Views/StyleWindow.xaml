<Window x:Class="FastVitae.Views.StyleWindow"
        Background="{StaticResource PanelBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FastVitae.Views"
        xmlns:model="clr-namespace:FastVitae.Model"
        Title="{views:T 'Text format'}" Width="400" SizeToContent="Height"
        WindowStartupLocation="Manual" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <!-- Live sample on white paper -->
        <Border Background="White" CornerRadius="3" Padding="10,8" Margin="0,0,0,12">
            <TextBlock x:Name="Sample" TextTrimming="CharacterEllipsis"/>
        </Border>

        <DockPanel>
            <ComboBox x:Name="SizeBox" DockPanel.Dock="Right" Width="76" MinWidth="0" Margin="8,0,0,0" MaxDropDownHeight="300"
                      ItemsSource="{x:Static model:TextStyle.Sizes}" SelectionChanged="Changed" ToolTip="{views:T 'Size'}"/>
            <ComboBox x:Name="FontBox" MinWidth="0" ItemsSource="{x:Static model:TextStyle.Fonts}" SelectionChanged="Changed" ToolTip="{views:T 'Font'}">
                <ComboBox.Resources>
                    <views:FontInstalledConverter x:Key="Installed"/>
                </ComboBox.Resources>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                <!-- Missing fonts: gray, not pickable -->
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Converter={StaticResource Installed}}" Value="False">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="ToolTip" Value="{views:T 'You need to install this font.'}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
        </DockPanel>

        <!-- Colour swatches -->
        <ListBox x:Name="ColorBox" ItemsSource="{x:Static model:TextStyle.Colors}" SelectionChanged="Changed" Margin="0,10,0,0"
                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Ring" BorderBrush="Transparent" BorderThickness="2" CornerRadius="14" Padding="2" Margin="0,0,4,0" Cursor="Hand">
                                    <Ellipse Width="22" Height="22" Fill="{Binding}" Stroke="#777777" StrokeThickness="1"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Ring" Property="BorderBrush" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <ToggleButton x:Name="BoldBox" Content="B" FontWeight="Bold" Width="36" Click="Changed" ToolTip="{views:T 'Bold'}"/>
            <ToggleButton x:Name="ItalicBox" Content="I" FontStyle="Italic" Width="36" Margin="6,0,0,0" Click="Changed" ToolTip="{views:T 'Italic'}"/>
            <ToggleButton x:Name="StrikeBox" Width="36" Margin="6,0,0,0" Click="Changed" ToolTip="{views:T 'Strikethrough'}">
                <TextBlock Text="S" TextDecorations="Strikethrough"/>
            </ToggleButton>
        </StackPanel>

        <Button x:Name="ApplyAllButton" HorizontalAlignment="Left" Margin="0,16,0,0" Click="ApplyAll_Click" Visibility="Collapsed"/>

        <DockPanel Margin="0,20,0,0">
            <Button Content="{views:T 'Reset'}" DockPanel.Dock="Left" Click="Reset_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{views:T 'Cancel'}" IsCancel="True"/>
                <Button Content="OK" IsDefault="True" Style="{StaticResource Primary}" Margin="0" Click="Ok_Click"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
