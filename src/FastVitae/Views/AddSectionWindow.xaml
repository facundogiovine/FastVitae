<Window x:Class="FastVitae.Views.AddSectionWindow"
        Background="{StaticResource PanelBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FastVitae.Views"
        Title="{views:T 'Add Section'}" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="{views:T 'Section title'}" Style="{StaticResource Label}" Margin="0,0,0,2"/>
        <TextBox x:Name="TitleBox" ToolTip="{views:T 'For example: PROJECTS'}"/>

        <TextBlock Text="{views:T 'Format'}" Style="{StaticResource Label}" Margin="0,16,0,4"/>
        <RadioButton x:Name="EntriesOption" Content="{views:T 'Name and Bulletpoints'}" IsChecked="True" Margin="0,2"
                     ToolTip="{views:T 'Like PROFESSIONAL EXPERIENCE: a name, a place, dates and bullets'}"/>
        <RadioButton x:Name="ColumnsOption" Content="{views:T 'Bullet Columns'}" Margin="0,6,0,2"
                     ToolTip="{views:T 'Like AREAS OF EXPERTISE: short bullets in three columns'}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{views:T 'Cancel'}" IsCancel="True"/>
            <Button Content="{views:T 'Add'}" IsDefault="True" Style="{StaticResource Primary}" Margin="0" Click="Add_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
