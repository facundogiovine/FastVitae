<Window x:Class="FastVitae.Views.AddSectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Section" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="Section title" Style="{StaticResource Label}" Margin="0,0,0,2"/>
        <TextBox x:Name="TitleBox" ToolTip="For example: PROJECTS"/>

        <TextBlock Text="Format" Style="{StaticResource Label}" Margin="0,16,0,4"/>
        <RadioButton x:Name="EntriesOption" Content="Name and Bulletpoints" IsChecked="True" Margin="0,2"
                     ToolTip="Like PROFESSIONAL EXPERIENCE: a name, a place, dates and bullets"/>
        <RadioButton x:Name="ColumnsOption" Content="Bullet Columns" Margin="0,6,0,2"
                     ToolTip="Like AREAS OF EXPERTISE: short bullets in three columns"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True"/>
            <Button Content="Add" IsDefault="True" Style="{StaticResource Primary}" Margin="0" Click="Add_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
