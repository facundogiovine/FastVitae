<Window x:Class="FastVitae.Views.CropWindow"
        Background="{StaticResource PanelBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FastVitae.Views"
        Title="{views:T 'Crop picture'}" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <StackPanel Orientation="Horizontal">
            <!-- Picture with the frame -->
            <Border Width="440" Height="440" Background="#2A2C30" CornerRadius="3">
                <Grid x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center"
                      MouseWheel="Stage_MouseWheel" MouseMove="Stage_MouseMove" MouseLeftButtonUp="Stage_MouseUp">
                    <Image x:Name="Photo" Stretch="Fill"/>
                    <Canvas x:Name="Overlay">
                        <Path x:Name="Shade" Fill="#99000000" IsHitTestVisible="False"/>
                        <Rectangle x:Name="Frame" Stroke="White" StrokeThickness="2" Fill="Transparent" Cursor="SizeAll"
                                   Tag="move" MouseLeftButtonDown="Grip_MouseDown"/>
                        <Rectangle x:Name="TopLeft" Width="12" Height="12" Fill="White" Cursor="SizeNWSE" Tag="tl" MouseLeftButtonDown="Grip_MouseDown"/>
                        <Rectangle x:Name="TopRight" Width="12" Height="12" Fill="White" Cursor="SizeNESW" Tag="tr" MouseLeftButtonDown="Grip_MouseDown"/>
                        <Rectangle x:Name="BottomLeft" Width="12" Height="12" Fill="White" Cursor="SizeNESW" Tag="bl" MouseLeftButtonDown="Grip_MouseDown"/>
                        <Rectangle x:Name="BottomRight" Width="12" Height="12" Fill="White" Cursor="SizeNWSE" Tag="br" MouseLeftButtonDown="Grip_MouseDown"/>
                    </Canvas>
                </Grid>
            </Border>

            <!-- CV header preview -->
            <Border Background="White" Width="360" Margin="16,0,0,0" Padding="20" CornerRadius="3" VerticalAlignment="Top">
                <DockPanel>
                    <Image x:Name="Result" DockPanel.Dock="Right" Height="100" Stretch="Uniform" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="NameText" FontFamily="Times New Roman" FontSize="26" FontWeight="Bold" Foreground="Black" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TitleText" FontFamily="Times New Roman" FontSize="16" Foreground="Black" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{views:T 'Cancel'}" IsCancel="True"/>
            <Button Content="{views:T 'Use picture'}" IsDefault="True" Style="{StaticResource Primary}" Margin="0" Click="Use_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
