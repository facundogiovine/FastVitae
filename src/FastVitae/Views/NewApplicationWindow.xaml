<Window x:Class="FastVitae.Views.NewApplicationWindow"
        Background="{StaticResource PanelBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FastVitae.Views"
        Title="{views:T 'New application'}" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="{views:T 'Company you are applying to:'}" Style="{StaticResource Label}" Margin="0,0,0,2"/>
        <TextBox x:Name="CompanyBox"/>

        <TextBlock Text="{views:T 'Field'}" Style="{StaticResource Label}"/>
        <ComboBox x:Name="FieldCombo" IsEditable="True" SelectionChanged="FieldCombo_Changed" LostFocus="FieldCombo_Changed"
                  ToolTip="{views:T 'Pick a Field or type a new one, for example: Software Development, Hospitality'}"/>

        <TextBlock Text="CV" Style="{StaticResource Label}"/>
        <ComboBox x:Name="CvCombo" ToolTip="{views:T 'The CV you are sending. A copy of its PDF is kept with this application.'}"/>

        <TextBlock Text="{views:T 'Expected Salary'}" Style="{StaticResource Label}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MinBox" Grid.Column="0" views:Hint.Text="{views:T 'Min'}"/>
            <TextBlock Grid.Column="1" Text="-" Margin="8,0" VerticalAlignment="Center"/>
            <TextBox x:Name="MaxBox" Grid.Column="2" views:Hint.Text="{views:T 'Max'}"/>
            <ComboBox x:Name="CurrencyCombo" Grid.Column="3" Style="{StaticResource CurrencyCombo}" Margin="8,0,0,0"
                      ToolTip="{views:T 'Type a country or a currency'}"/>
        </Grid>

        <TextBlock Text="{views:T 'Link'}" Style="{StaticResource Label}"/>
        <TextBox x:Name="LinkBox" views:Hint.Text="https://www.linkedin.com/jobs/view/..."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{views:T 'Cancel'}" IsCancel="True"/>
            <Button Content="{views:T 'Save'}" IsDefault="True" Style="{StaticResource Primary}" Margin="0" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
