<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>FastVitae.ico</ApplicationIcon>
    <Product>Fast Vitae</Product>
    <AssemblyTitle>Fast Vitae</AssemblyTitle>
    <Version>1.0.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="FamFamFam.Flags.Wpf" Version="1.2.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded CV style and fonts -->
    <EmbeddedResource Include="Rendering\cv.css" />
    <EmbeddedResource Include="Fonts\*.ttf" />
  </ItemGroup>

</Project>
